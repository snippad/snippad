{
  "name": "SnipPad",
  "description": "A fast, polished client for managing your code snippets like a pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "homepage": "https://snippad.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/snippad/snippad"
  },
  "bugs": {
    "url": "https://github.com/snippad/snippad/issues"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "snippad",
    "url": "https://github.com/snippad"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "build": "vite build && electron-builder",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "postinstall": "mkdir -p public/monaco && cp -r node_modules/monaco-editor/min/vs public/monaco/"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "reicon-react": "^1.1.302",
    "semver": "^7.8.5",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
